/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' https://*.cdninstagram.com https://*.fbcdn.net data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://www.instagram.com; font-src 'self'; connect-src 'self' https://www.instagram.com; frame-src https://open.spotify.com https://www.youtube.com https://www.linkedin.com https://embed.podcasts.apple.com https://www.instagram.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'

/assets/*
  Cache-Control: public, max-age=604800
